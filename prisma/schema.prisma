// Prisma schema mapeado em cima do banco Neon já existente.
// Nomes de tabela/coluna em @@map/@map preservam o schema original (worker, predios, feedback)
// para não quebrar nada que já existe; os nomes dos models em inglês são só para o código.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Staff (tabela física: worker) ----------
model Staff {
  id          BigInt   @id @default(autoincrement())
  nome        String?  @db.VarChar(255)
  telefone    String?  @db.VarChar(255)
  horasSemana Float?   @map("horas_semana")
  staffNumber String?  @map("staff_number") @db.VarChar(255)

  // Status especial ("p45" | "le" | "blocked" | null = ativo). Quando
  // preenchido, o staff não tem vínculo real com prédio (StaffBuilding) —
  // ver seção "Outros" na home.
  status    String?   @db.VarChar(20)
  blockedAt DateTime? @map("blocked_at")

  // Último dia trabalhado — obrigatório tanto pro "p45" (saída/dispensa)
  // quanto pro "le" (transferido pra outra empresa); limpo no servidor
  // sempre que o status muda pra outra coisa (mesmo padrão de blockedAt
  // acima). voluntaryLeave/leaveReasons abaixo são só do "p45".
  lastWorkingDay  DateTime? @map("last_working_day") @db.Date
  voluntaryLeave  Boolean?  @map("voluntary_leave")
  // Motivo(s) de saída — pode ser mais de um. Só relevante quando
  // status === "p45" e voluntaryLeave === false. leaveReasonNote é sempre
  // editável nesse caso (não só quando "other" está entre os motivos), mas
  // só obrigatório (na validação) quando "other" está selecionado.
  leaveReasons    String[]  @default([]) @map("leave_reasons")
  leaveReasonNote String?   @map("leave_reason_note") @db.VarChar(500)

  // Campo específico do status "le": pra qual empresa o staff está indo —
  // opcional (nem sempre se sabe/importa registrar). Limpo sempre que o
  // status muda pra outra coisa.
  leDestinationCompany String? @map("le_destination_company") @db.VarChar(255)

  // Snapshot do nome do último prédio (StaffBuilding, preferindo o vínculo
  // "cleaner") no momento em que o status virou "p45" — capturado no
  // servidor antes de apagar os vínculos (ver PUT /api/staff/[id]), porque
  // esses vínculos são removidos ao salvar o P45. Texto livre (não FK) de
  // propósito: sobrevive mesmo se o prédio for renomeado/excluído depois.
  // Usado só pelo relatório de saída (lib/p45Report.ts).
  lastBuildingName String? @map("last_building_name") @db.VarChar(255)

  observations Feedback[]
  buildingsAsTeamLeader StaffBuilding[]
  // Times que este staff lidera hoje (ver TeamLeader) — pode ser mais de um,
  // e um time pode ter mais de um líder ao mesmo tempo (co-liderança).
  teamsLed     TeamLeader[]
  history      StaffHistory[]
  loginAccount User?

  @@map("worker")
}

// ---------- Building (tabela física: predios) ----------
model Building {
  id   BigInt @id @default(autoincrement())
  nome String @unique @db.VarChar(255)
  // Horas que a UCD (faculdade/cliente) libera pra gente naquele prédio —
  // o orçamento de origem. Editado em /buildings/[id] e /teams/[id]
  // (UcdHoursCard). Pode ser diferente de horasDisponiveis (ver abaixo):
  // nem toda hora que a UCD libera é necessariamente já repassada pro time.
  ucdHours Float? @map("ucd_hours")
  // Horas que a gente de fato libera/repassa pro team leader gerir naquele
  // prédio (o que aparece como "Xh available" no cabeçalho do prédio,
  // editado em /buildings/[id] e /teams/[id] via BuildingHoursCard). É o
  // valor usado por BuildingStatsBadge pra comparar contra as horas
  // semanais somadas dos cleaners cadastrados (Surplus/Short).
  horasDisponiveis Float? @map("horas_disponiveis")
  workOrder String? @map("work_order")

  // Time ao qual este prédio está alocado (ver model Team). Independente de
  // quem é o team leader hoje — o prédio fica no time mesmo que o time
  // esteja sem líder conectado no momento.
  teamId BigInt? @map("team_id")
  // Posição do prédio dentro do time (0, 1, 2...) — controla a ordem de
  // exibição em /teams/[id] e, por consequência, a ordem em que os prédios
  // aparecem na folha impressa (SIGN IN/OUT do líder e no editor semanal,
  // ver getTeamsData e GET /api/timesheets). Editado via PUT
  // /api/teams/[id]/buildings/order (setas pra cima/baixo na tela).
  // Default 0 pra todos = empata e cai no tie-break por id (ordem de
  // criação, comportamento de hoje) até alguém reordenar.
  teamOrder Int @default(0) @map("team_order")
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)

  teamLeaders   StaffBuilding[]
  slots         BuildingSlot[]
  covers        BuildingCover[]
  timesheets    Timesheet[]
  fortnightPlans FortnightPlan[]
  hoursLogs     BuildingHoursLog[]
  history       StaffHistory[]

  @@map("predios")
}

// ---------- Horas gastas lançadas por semana (tabela nova: building_hours_log) ----------
// Building.ucdHours é editado em /buildings/[id] e /teams/[id]
// (UcdHoursCard) — é o valor AO VIVO, sempre o atual. Esta tabela é o real:
// o Master lança, semana a semana, quanto foi de fato gasto naquele prédio
// (ver /hours-control), pra dar pra comparar orçado (UCD) x gasto e gerar o
// balanço. `ucdHours` aqui é um SNAPSHOT do valor ao vivo do prédio, tirado
// só na primeira vez que a semana é lançada (ver PUT
// /api/buildings/[id]/hours-log) — depois disso fica congelado, mesmo que o
// valor ao vivo do prédio mude depois (orçamento de mês passado não pode
// mudar retroativamente só porque o orçamento deste mês mudou). Semanas
// nunca lançadas não têm snapshot — mostram o valor ao vivo até serem
// lançadas pela primeira vez. Uma linha por prédio+semana; hoursSpent não é
// derivado automaticamente dos cleaners cadastrados (esse cálculo já existe
// em outro lugar — dashboard/timesheets — e é só uma estimativa).
model BuildingHoursLog {
  id         BigInt   @id @default(autoincrement())
  buildingId BigInt   @map("building_id")
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  weekStart  DateTime @map("week_start") @db.Date
  hoursSpent Float    @map("hours_spent")
  ucdHours   Float?   @map("ucd_hours")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([buildingId, weekStart])
  @@map("building_hours_log")
}

// ---------- Time (tabela nova: team) ----------
// Um time é a unidade estável: tem número e prédios alocados a ele
// independente de quem é o team leader no momento (ver /teams). O(s) team
// leader(s) são "conexões" (ver TeamLeader abaixo — um time pode ter mais de
// um, ex.: dois team leaders dividindo o mesmo time) que podem ser trocadas
// sem afetar os prédios do time — substitui o antigo modelo onde o team
// leader "era dono" direto dos prédios via StaffBuilding.role="team_leader"
// (link legado, mantido no banco mas não usado mais por esse fluxo — ver
// /team-leaders).
model Team {
  id     BigInt @id @default(autoincrement())
  number Int?

  leaders   TeamLeader[]
  buildings Building[]
  history   StaffHistory[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("team")
}

// ---------- Líder(es) de um time (tabela nova: team_leader) ----------
// N:N entre Team e Staff: um time pode ter mais de um líder (co-liderança) e
// o mesmo staff pode liderar mais de um time. `horas` é por vínculo (mesma
// pessoa pode ter cargas diferentes em times diferentes) — substitui o antigo
// Team.leaderId/leaderHours (single).
model TeamLeader {
  teamId  BigInt @map("team_id")
  staffId BigInt @map("staff_id")
  horas   Float?

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([teamId, staffId])
  @@map("team_leader")
}

// ---------- Trilha/histórico do staff (tabela nova: staff_history) ----------
// Uma linha por INTERVALO: aberta (endedAt = null) enquanto vale, fechada
// (endedAt preenchido) quando termina. Substitui a necessidade de reconstruir
// "desde quando"/"quanto tempo ficou" a partir de StaffBuilding/TeamLeader —
// esses vínculos são apagados e recriados a cada edição (ver PUT
// /api/staff/[id]), então o createdAt deles não é confiável como histórico.
// `kind`:
//   "building"           -> cleaner num prédio (buildingId preenchido)
//   "team_leader"        -> conectado como líder real de um time (teamId)
//   "team_leader_cover"  -> cobrindo a função de líder temporariamente, SEM
//                           estar conectado de verdade (não mexe em acesso
//                           nem nos prédios do time) — ver /teams/[id]
// buildingName/teamNumber são snapshot (sobrevivem a rename/exclusão do
// prédio/time), mesmo padrão de Staff.lastBuildingName.
model StaffHistory {
  id      BigInt  @id @default(autoincrement())
  // Nulo pra entrada manual de alguém sem cadastro de Staff (ex.: saiu há
  // muito tempo, nunca chegou a ser cadastrado) — ver POST
  // /api/staff-history e BuildingStaffHistoryCard. Nesse caso o nome (e,
  // opcionalmente, o staff number) fica solto em staffNome/staffNumber
  // abaixo em vez de vir do relacionamento. Continua Cascade: se o staff
  // vinculado for apagado, a entrada dele some junto (comportamento de
  // sempre) — só passa a ser opcional pra permitir a entrada solta.
  staffId BigInt? @map("staff_id")
  staff   Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // Só preenchido quando staffId é nulo — texto livre digitado na tela.
  staffNome   String? @map("staff_nome") @db.VarChar(255)
  staffNumber String? @map("staff_number") @db.VarChar(50)

  kind String @db.VarChar(30)

  buildingId   BigInt?   @map("building_id")
  building     Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  buildingName String?   @map("building_name") @db.VarChar(255)

  teamId     BigInt? @map("team_id")
  team       Team?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamNumber Int?    @map("team_number")

  horas     Float?
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  // Só usado no "team_leader_cover" hoje (motivo/observação livre).
  note      String?   @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("staff_history")
}

// ---------- Vagas fixas do prédio (posições com horas definidas, independente de quem ocupa hoje) ----------
model BuildingSlot {
  id         BigInt   @id @default(autoincrement())
  buildingId BigInt   @map("building_id")
  horas      Float
  ordem      Int      @default(0)

  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("building_slot")
}

// ---------- Vínculo N:N entre staff e prédios (tabela nova: staff_building) ----------
model StaffBuilding {
  // Chave sintética: o mesmo staff pode ter MAIS DE UM vínculo "cleaner" no
  // mesmo prédio (ex.: dois turnos/postos, cada um com suas horas) — por isso
  // a PK não é mais [staffId, buildingId, role]. O vínculo "team_leader"
  // continua sendo no máximo um por staff+prédio, garantido por um índice
  // único PARCIAL (role = 'team_leader') criado na migration 27 — todo o
  // código de times (lib/teams.ts, /my, portal do Team Leader) depende disso.
  id         BigInt   @id @default(autoincrement())
  staffId    BigInt   @map("staff_id")
  buildingId BigInt   @map("building_id")
  horas      Float?

  // "cleaner" | "team_leader" — papel deste vínculo específico (staff+prédio).
  role       String   @default("cleaner") @db.VarChar(20)

  // Posição manual do cleaner na folha de ponto (Sign In & Sign Out Book).
  // NULL em TODOS os vínculos cleaner do prédio = ordem automática por horas
  // (maior primeiro, comportamento padrão). Assim que o Master reordena na
  // página do prédio, todos os vínculos cleaner ganham 0,1,2... e a folha
  // passa a seguir essa ordem. "Reset to automatic" volta tudo pra NULL.
  // Só usado pra role="cleaner" (ver lib/timesheetRows.ts). Migration 28.
  ordem      Int?

  // Building/WO que aparecem NA FOLHA pra este vínculo específico. NULL =
  // usa Building.nome / Building.workOrder (comportamento padrão de todo
  // prédio). Preenchido só onde a linha da pessoa precisa de um rótulo
  // próprio — hoje o prédio "Team Leaders", onde cada team leader mostra a
  // área que cobre. Segue a PESSOA em qualquer ordem (diferente do antigo
  // TimesheetSheetOverride escopo row:<índice>). Migration 29.
  predioLabel String? @map("predio_label") @db.VarChar(255)
  workOrder   String? @map("work_order")   @db.VarChar(255)

  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")

  @@index([staffId])
  @@index([buildingId])
  @@map("staff_building")
}

// ---------- Cover avulso na folha de ponto: staff cobrindo o prédio por um
// dia, sem criar vínculo (StaffBuilding) real. Só texto — sem FK pra Staff.
model BuildingCover {
  id          BigInt   @id @default(autoincrement())
  buildingId  BigInt   @map("building_id")
  nome        String?  @db.VarChar(255)
  staffNumber String?  @map("staff_number") @db.VarChar(255)
  horas       Float?
  createdAt   DateTime @default(now()) @map("created_at")

  building    Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@map("building_cover")
}

// ---------- Observações (tabela física já existente: feedback) ----------
model Feedback {
  id       BigInt    @id @default(autoincrement())
  texto    String?   @db.VarChar(255)
  data     DateTime? @default(now())
  workerId BigInt?   @map("worker_id")

  staff    Staff?    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

// ---------- Conta de login do app (tabela nova: app_user) ----------
// Separado de Staff (que é o cadastro de funcionário gerenciado, não uma
// conta de acesso). "role" aqui é o papel de ACESSO ao app (master/
// supervisor/team_leader/pending) — não confundir com StaffBuilding.role,
// que é o papel de trabalho da pessoa no prédio (cleaner/team_leader).
// "pending" = conta criada pela própria pessoa em /register, ainda sem
// papel definido, até o Master aprovar em /users.
model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         String   @db.VarChar(20)
  active       Boolean  @default(true)

  // Só preenchido quando role = "team_leader": vincula a conta ao Staff que
  // já tem os vínculos StaffBuilding (role="team_leader") existentes, para
  // não duplicar a informação de quais prédios a pessoa atende.
  staffId      BigInt?  @unique @map("staff_id")
  staff        Staff?   @relation(fields: [staffId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  timesheetsCreated   Timesheet[] @relation("TimesheetCreatedBy")
  timesheetsSubmitted Timesheet[] @relation("TimesheetSubmittedBy")
  timesheetsReviewed  Timesheet[] @relation("TimesheetReviewedBy")
  timesheetsDeleted   Timesheet[] @relation("TimesheetDeletedBy")
  fortnightPlansLaunched FortnightPlan[] @relation("FortnightPlanLaunchedBy")
  adjustmentsUpdated  Adjustment[] @relation("AdjustmentUpdatedBy")

  @@map("app_user")
}

// ---------- Folha de ponto digital (tabela nova: timesheet) ----------
// Uma linha por prédio+semana. "entries" guarda o snapshot das linhas
// (cleaners/vagas em aberto/covers) tirado no momento da criação, editado
// depois só dentro do próprio JSON — não é re-derivado do estado ao vivo de
// StaffBuilding/BuildingSlot/BuildingCover em cada leitura.
model Timesheet {
  id         BigInt   @id @default(autoincrement())
  buildingId BigInt   @map("building_id")
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  weekStart  DateTime @map("week_start") @db.Date

  // "weekly" (padrão, cobre weekStart..+4 dias) | "biweekly" (cobre
  // weekStart..+13 dias — a segunda semana não ganha uma linha própria,
  // fica dentro do mesmo registro via entries.rows[].days).
  periodType String   @default("weekly") @map("period_type") @db.VarChar(20)

  status     String   @default("draft") @db.VarChar(20)

  entries    Json     @default("{\"rows\":[]}")

  createdByUserId   BigInt?   @map("created_by_user_id")
  createdByUser     User?     @relation("TimesheetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  submittedByUserId BigInt?   @map("submitted_by_user_id")
  submittedByUser   User?     @relation("TimesheetSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  submittedAt       DateTime? @map("submitted_at")

  reviewedByUserId  BigInt?   @map("reviewed_by_user_id")
  reviewedByUser    User?     @relation("TimesheetReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt        DateTime? @map("reviewed_at")

  // Exclusão vira "mover pra lixeira": a linha continua existindo, só some
  // das telas normais (GET /api/timesheets filtra deletedAt=null por
  // padrão). Dá pra restaurar em /review/excluidas.
  deletedAt         DateTime? @map("deleted_at")
  deletedByUserId   BigInt?   @map("deleted_by_user_id")
  deletedByUser     User?     @relation("TimesheetDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Foto do `entries` no instante do PRIMEIRO envio (draft -> submitted)
  // dessa folha. Nunca reescrito depois (não há transição submitted -> draft
  // hoje). Baseline usado pra detectar "ajuste" em edições feitas depois do
  // envio — ver PATCH /api/timesheets/[id] e lib/timesheetAdjustment.ts.
  submittedSnapshot Json? @map("submitted_snapshot")

  // Preenchido só quando esta linha nasceu de um Launch de quinzenal (ver
  // FortnightPlan abaixo) — uma linha é ou week1 ou week2 de no máximo um
  // plano, nunca os dois.
  fortnightAsWeek1 FortnightPlan? @relation("FortnightWeek1")
  fortnightAsWeek2 FortnightPlan? @relation("FortnightWeek2")

  adjustment Adjustment?

  @@unique([buildingId, weekStart])
  @@map("timesheet")
}

// ---------- Previsão quinzenal lançada (tabela nova: fortnight_plan) ----------
// Histórico do que o Team Leader preencheu na tela quinzenal (10 dias) no
// momento do "Launch". Congelado — nunca mais editado depois de criado. As
// duas folhas reais geradas pelo Launch (semanais, no fluxo normal de
// submit/review) ficam linkadas aqui: week1 é a PRÓPRIA linha biweekly
// original (mutada in place pro periodType "weekly"), week2 é uma linha nova
// em weekStart+7 — nunca se insere uma 2ª linha no weekStart original (ver
// POST /api/timesheets/fortnight/launch).
model FortnightPlan {
  id             BigInt   @id @default(autoincrement())
  buildingId     BigInt   @map("building_id")
  building       Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  fortnightStart DateTime @map("fortnight_start") @db.Date

  forecastEntries Json @map("forecast_entries")

  week1TimesheetId BigInt    @unique @map("week1_timesheet_id")
  week1Timesheet   Timesheet @relation("FortnightWeek1", fields: [week1TimesheetId], references: [id], onDelete: Cascade)
  week2TimesheetId BigInt    @unique @map("week2_timesheet_id")
  week2Timesheet   Timesheet @relation("FortnightWeek2", fields: [week2TimesheetId], references: [id], onDelete: Cascade)

  launchedByUserId BigInt?  @map("launched_by_user_id")
  launchedByUser   User?    @relation("FortnightPlanLaunchedBy", fields: [launchedByUserId], references: [id], onDelete: SetNull)
  launchedAt       DateTime @default(now()) @map("launched_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([buildingId, fortnightStart])
  @@map("fortnight_plan")
}

// ---------- Edições da folha impressa (tabela nova: timesheet_sheet_override) ----------
// Guarda só as personalizações feitas na tela em /timesheets/[id],
// /timesheets/leader/[id] e no editor combinado (Building/WO por linha +
// nome em negrito do topo) — nunca escreve em predios/team/timesheet.
// subjectType/subjectId é uma referência solta (sem FK, texto livre — mesmo
// padrão de Staff.lastBuildingName) porque pode apontar tanto pra um
// Building (linhas/covers de uma folha ao vivo, reaproveitado tanto em
// /timesheets/[id] quanto na visão combinada do líder) quanto pra um Team
// (nome combinado do topo da folha do líder, que junta vários prédios) ou
// um Timesheet (linhas/covers/topo do editor combinado, específico daquela
// semana). scope: "header" | "row:<índice>" | "cover:<coverId>".
model TimesheetSheetOverride {
  id          BigInt   @id @default(autoincrement())
  subjectType String   @map("subject_type") @db.VarChar(20)
  subjectId   BigInt   @map("subject_id")
  scope       String   @db.VarChar(50)

  nomePredio  String?  @map("nome_predio") @db.VarChar(255)
  workOrder   String?  @map("work_order") @db.VarChar(255)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([subjectType, subjectId, scope])
  @@map("timesheet_sheet_override")
}

// ---------- Sign In/Out digitados na folha impressa (tabela nova: timesheet_sheet_sign) ----------
// Guarda o texto digitado nas colunas SIGN IN/SIGN OUT de /timesheets/[id]
// (folha por prédio, sem semana real associada — ver comentário em
// TimesheetView.tsx). Mesmo padrão solto de subjectType/subjectId do
// TimesheetSheetOverride acima (hoje só "building"). scope identifica a
// célula: "row:<índice>:<diaKey>" (linha de staff/vaga), "cover:<coverId>:
// <diaKey>" (cover) ou "estatesEvents:<diaKey>" (linha fixa ESTATES EVENTS).
// De propósito NÃO cobre as linhas em branco de preenchimento livre
// (BlankRow) — não têm identidade estável pra amarrar um registro.
// Por escolha do usuário, não amarra a uma semana específica: o valor
// digitado fica valendo até ser sobrescrito, não reseta toda semana.
model TimesheetSheetSign {
  id          BigInt   @id @default(autoincrement())
  subjectType String   @map("subject_type") @db.VarChar(20)
  subjectId   BigInt   @map("subject_id")
  scope       String   @db.VarChar(50)

  signIn      String?  @map("sign_in") @db.VarChar(20)
  signOut     String?  @map("sign_out") @db.VarChar(20)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([subjectType, subjectId, scope])
  @@map("timesheet_sheet_sign")
}

// ---------- Ajuste pós-envio (tabela nova: adjustment) ----------
// Registrado quando o Team Leader edita `entries` de uma folha semanal DEPOIS
// do primeiro envio (draft -> submitted) — compara contra o que foi
// congelado em Timesheet.submittedSnapshot naquele momento. Um registro por
// folha (upsert): se a edição fizer o conteúdo voltar a bater com o que foi
// enviado, o registro é apagado (ver PATCH /api/timesheets/[id]). Não exige
// aprovação própria — é só um log visível na aba Adjustments.
model Adjustment {
  id              BigInt    @id @default(autoincrement())
  timesheetId     BigInt    @unique @map("timesheet_id")
  timesheet       Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  beforeEntries Json @map("before_entries")
  afterEntries  Json @map("after_entries")
  diff          Json // pré-computado, ver lib/timesheetAdjustment.ts

  updatedByUserId BigInt? @map("updated_by_user_id")
  updatedByUser   User?   @relation("AdjustmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("adjustment")
}
