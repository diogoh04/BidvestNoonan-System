# PostgreSQL (Neon) — pooled connection, used by the app at runtime
DATABASE_URL=

# PostgreSQL (Neon) — direct connection, used for migrations
DIRECT_URL=

# Random secret used to sign the session cookie (generate with:
# python3 -c "import secrets; print(secrets.token_hex(32))")
AUTH_SECRET=

# Login agora é por usuário/senha (tabela app_user), não mais uma senha
# única compartilhada. Depois de rodar prisma/manual-migration-7.sql, crie
# a primeira conta master com:
#   npx tsx scripts/seed-user.ts <username> <password> master

# Vercel Blob — usado pelas fotos anexadas nas notas de staff (POST
# /api/upload, ver Feedback.fotos). Crie um "Blob Store" no dashboard da
# Vercel (Storage -> Create Database -> Blob) e conecte ao projeto: em
# produção a Vercel injeta essa variável automaticamente; localmente, copie
# o valor de lá (Storage -> seu store -> .env.local tab).
BLOB_READ_WRITE_TOKEN=
